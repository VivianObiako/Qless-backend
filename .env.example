# Postgres connection string. Local default matches docker-compose.yml.
DATABASE_URL=postgres://qless:qless@localhost:5433/qless?sslmode=disable

# Separate database for the integration tests. Created by scripts/init-test-db.sql.
TEST_DATABASE_URL=postgres://qless:qless@localhost:5433/qless_test?sslmode=disable

# Port the API listens on. Hosts that inject their own PORT override this.
PORT=8080

# Origins allowed for CORS and the WebSocket handshake. Comma separated, so a
# production domain and a preview deployment can both be served at once:
#   ALLOWED_ORIGIN=https://qless.app,https://qless-git-branch.vercel.app
ALLOWED_ORIGIN=http://localhost:3000

# Web Push. Optional: without a pair the API runs and the customer's pass keeps
# its in-page nudge. Generate a pair once with `go run ./cmd/vapid` and keep the
# private key secret; subscriptions are bound to the public key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
